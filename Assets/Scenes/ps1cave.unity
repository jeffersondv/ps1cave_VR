  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Anal\xF3gico esquerdo</b>: para frente ou para tr\xE1s anda um bloco;
    para os lados, passo lateral.\n<b>Anal\xF3gico direito</b>: gira 90\xB0 para
    a esquerda ou para a direita.\n<b>Gatilho ou bot\xE3o A / X</b>: interage com
    o que est\xE1 \xE0 sua frente (personagens, portas, ba\xFAs) e avan\xE7a os di\xE1logos.\n<b>Apontar
    o controle (laser) + gatilho</b>: clica em bot\xF5es e na op\xE7\xE3o vermelha
    \"Ajuda especial\".\n<b>Olhar fixo</b> para o c\xEDrculo vermelho tamb\xE9m escolhe
    a \"Ajuda especial\".\n<b>Bot\xE3o Menu</b> (controle esquerdo): abre e fecha
    esta ajuda. <b>B / Y</b> tamb\xE9m fecham.\n<b>Bot\xE3o Meta</b> (controle direito):
    menu do sistema do Quest."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
