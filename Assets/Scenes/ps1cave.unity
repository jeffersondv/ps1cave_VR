  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1009098390}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1db7214a46edc334bbe818b8eb2e9a87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  helpText: {fileID: 1456001595}
  ollamaManager: {fileID: 1009098398}
  promptForOllama: 
  defaultHelpText: 
  idleTimeLimit: 5
  movementThreshold: 0.01
  modo: 0
  usarDicasFixasSemOllama: 1
  enviarEstadoDoJogo: 1
  dicasPorAndar:
  - andar: 0
    nome: "Sal\xE3o de entrada"
    contexto: "Corredor curto com um Mago no fim. N\xE3o h\xE1 porta vis\xEDvel:
      no meio do corredor existe uma passagem secreta na parede que leva a uma escada
      para descer. O Mago d\xE1 uma pista especial se o jogador falar com ele duas
      vezes."
    objetivo: Falar com o Mago (duas vezes) e encontrar a passagem secreta na parede
      para descer a escada.
    dicasFixas:
    - "Quem guarda este sal\xE3o sabe mais do que diz. Insista na conversa."
    - "Nem toda parede \xE9 s\xF3lida. Procure no meio do corredor."
    - "Fique no meio do corredor, vire-se para a parede e siga em frente: a passagem
      secreta leva \xE0 escada."
    etapas:
    - quando: 4
      objetivo: "Subir at\xE9 o primeiro andar e abrir a porta m\xE1gica com o cristal."
      dicas:
      - "O cristal pulsa: a porta que ele abre fica acima de voc\xEA."
      - "Volte pela escada e procure a porta m\xE1gica no primeiro andar."
  - andar: 1
    nome: Primeiro andar
    contexto: "H\xE1 uma porta comum, uma escada para descer e uma porta m\xE1gica
      que leva \xE0 sa\xEDda da caverna. A porta m\xE1gica s\xF3 abre com o cristal
      (ou com magia), que fica nos andares de baixo."
    objetivo: "Descer a escada para buscar o cristal e depois voltar para abrir a
      porta m\xE1gica da sa\xEDda."
    dicasFixas:
    - "A sa\xEDda est\xE1 perto, mas protegida por uma for\xE7a m\xE1gica."
    - "A porta m\xE1gica n\xE3o cede sem o cristal. Ele est\xE1 nas profundezas."
    - "Des\xE7a a escada deste andar e procure o cristal; depois volte aqui e atravesse
      a porta m\xE1gica."
    etapas:
    - quando: 4
      objetivo: "Usar o cristal na porta m\xE1gica deste andar para sair da caverna."
      dicas:
      - "O cristal reage a uma for\xE7a m\xE1gica pr\xF3xima."
      - "Leve o cristal at\xE9 a porta m\xE1gica deste andar."
      - "V\xE1 at\xE9 a porta m\xE1gica e interaja com ela: o cristal vai abri-la
        e libertar voc\xEA."
  - andar: 2
    nome: Segundo andar
    contexto: "Andar de passagem. Corredores levam a uma escada para descer. H\xE1
      uma porta trancada com chave que leva a um guia; a chave fica no andar de baixo."
    objetivo: Encontrar a escada para descer e continuar a busca pelo cristal.
    dicasFixas:
    - O caminho continua para baixo.
    - "Contorne os corredores: h\xE1 uma escada para descer."
    - "Ignore a porta trancada por enquanto e siga pelos corredores at\xE9 a escada
      para descer."
    etapas:
    - quando: 4
      objetivo: "Subir a escada de volta ao primeiro andar e abrir a porta m\xE1gica."
      dicas:
      - "Com o cristal em m\xE3os, o caminho agora \xE9 para cima."
      - Encontre a escada para subir e volte ao primeiro andar.
  - andar: 3
    nome: Terceiro andar
    contexto: "Andar com v\xE1rios corredores e portas comuns. H\xE1 um ba\xFA com
      a chave do calabou\xE7o, um personagem estranho e guias que d\xE3o conselhos.
      Uma escada desce para o andar do drag\xE3o."
    objetivo: "Pegar a chave no ba\xFA (interagir com ele) e depois descer a escada."
    dicasFixas:
    - "Algo guardado aqui abrir\xE1 uma porta l\xE1 embaixo."
    - "Procure o ba\xFA: dentro dele h\xE1 uma chave."
    - "Interaja com o ba\xFA para pegar a chave e depois des\xE7a a escada deste
      andar."
    etapas:
    - quando: 4
      objetivo: "Subir de volta ao primeiro andar e abrir a porta m\xE1gica."
      dicas:
      - "Com o cristal em m\xE3os, o caminho agora \xE9 para cima."
      - Procure a escada para subir e volte ao primeiro andar.
    - quando: 2
      objetivo: "Descer a escada at\xE9 o andar mais profundo."
      dicas:
      - 'A chave pesa no seu bolso: a porta dela fica mais abaixo.'
      - Procure a escada para descer deste andar.
      - "Siga at\xE9 a escada para descer: a porta trancada est\xE1 no andar de baixo."
  - andar: 4
    nome: "Covil do drag\xE3o"
    contexto: "Andar mais profundo. Um drag\xE3o mortal fica em um corredor: falar
      com ele encerra a aventura. Uma porta trancada com chave e uma porta comum
      levam ao Dezoriano, que guarda o cristal."
    objetivo: "Evitar o drag\xE3o, abrir a porta trancada com a chave, falar com
      o Dezoriano para obter o cristal e voltar ao primeiro andar para abrir a porta
      m\xE1gica."
    dicasFixas:
    - 'Cuidado: nem toda criatura aqui quer conversar.'
    - "Evite o drag\xE3o. Use a chave na porta trancada e procure o guardi\xE3o do
      cristal."
    - "N\xE3o fale com o drag\xE3o. Abra a porta trancada, fale com o Dezoriano para
      pegar o cristal e volte \xE0 porta m\xE1gica."
    etapas:
    - quando: 4
      objetivo: "Voltar subindo at\xE9 o primeiro andar e abrir a porta m\xE1gica."
      dicas:
      - "O cristal \xE9 seu. Agora fuja das profundezas."
      - "Evite o drag\xE3o e suba as escadas at\xE9 o primeiro andar."
      - "Suba todas as escadas at\xE9 o primeiro andar e use o cristal na porta m\xE1gica."
    - quando: 1
      objetivo: "Voltar ao andar de cima e pegar a chave no ba\xFA."
      dicas:
      - "Uma porta aqui exige algo que voc\xEA deixou para tr\xE1s."
      - "A porta trancada precisa da chave do ba\xFA do andar de cima."
      - "Suba a escada, pegue a chave no ba\xFA e volte para abrir a porta trancada."
  maxPalavras: 25
  maxCaracteres: 160
  maxPersonaChars: 300
  logPrompts: 0
